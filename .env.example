# Copy to .env and adjust.
MONGODB_URI=mongodb://127.0.0.1:27017/match-tickets
PORT=4000
# Signs admin session cookies. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is used and admins are signed out on every restart.
SESSION_SECRET=
